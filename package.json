{
  "name": "zamp-platform",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "dev": "turbo run dev --parallel --concurrency 20",
    "dev-coder": "turbo run dev-coder --parallel --concurrency 20",
    "start-coder": "turbo run start-coder",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "prettier": "prettier --config --list-different",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write",
    "prepare": "husky",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "test:coverage": "turbo run test -- --coverage",
    "test:watch": "turbo run test -- --watch"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@imagekit/next": "^2.1.3",
    "next": "^16.1.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "ts-node": "^10.9.2",
    "turbo": "^2.4.4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@10.5.0",
  "overrides": {
    "eslint": "^9.39.2"
  }
}
