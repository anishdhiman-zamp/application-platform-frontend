{
  "extends": "@zamp-platform/config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "src/",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "incremental": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
