{
  "name": "@zamp-platform/svg-loader",
  "version": "1.0.0",
  "description": "SVG loader for client-side usage",
  "main": "./dist/svg-loader.js",
  "module": "./dist/svg-loader.js",
  "types": "./dist/svg-loader.d.ts",
